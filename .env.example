# This is a template file - NEVER commit real secrets to git
# Copy this to .env and fill in your actual values
# IMPORTANT: .env should be in .gitignore and NEVER pushed to GitHub

# Server Configuration
PORT=5000
NODE_ENV=production

# Security - Change these values in production!
JWT_SECRET=change-this-to-a-secure-random-string
CORS_ORIGIN=https://your-production-domain.com

# Admin Credentials - Change in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password

# Database - Set your MongoDB connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_DB_NAME=spvb-downloader

# Storage - Set your Cloudinary credentials
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_FOLDER=spvb/production/downloads

# Game Config
GAME_URL=https://example.com/game
VIDEO_FORMAT=mp4

# File Management
MAX_UPLOAD_SIZE=52428800
TEMP_DIR=/tmp/spvb
UPLOAD_DIR=./uploads

# Cleanup
CLEANUP_INTERVAL=300
CLEANUP_TIME_LIMIT=1800
ENABLE_AUTO_CLEANUP=true

# Downloads
MAX_CONCURRENT_DOWNLOADS=5
DOWNLOAD_TIMEOUT=30000
DOWNLOAD_RETRY_ATTEMPTS=3

# Production
DEBUG=false
REQUEST_LOGGING=true
