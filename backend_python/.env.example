# Server Configuration
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# MongoDB Configuration (REQUIRED - Update with your MongoDB URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# For local development: mongodb://localhost:27017

# Cloudinary Configuration (REQUIRED - For file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Session Configuration
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Download Configuration (Optional)
DOWNLOAD_TIMEOUT=900000
DOWNLOAD_QUALITY=best
VIDEO_FORMAT=mp4

# File Storage Path (Optional - defaults to ~/Downloads/SPVB-Downloads)
SAVE_PATH=/tmp/spvb-downloads
